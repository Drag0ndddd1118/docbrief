# Copy to .env and fill in. Never commit your real .env.

# --- Required for live mode (get a key at https://tokenfactory.nebius.com) ---
NEBIUS_API_KEY=

# --- Optional overrides (defaults shown; IDs verified against GET /v1/models on 2026-10-28) ---
# Main model: summaries, metric extraction, grounded Q&A (Nemotron 3 Super)
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Fast model: per-section map step on long documents + query rewriting (Nemotron 3 Nano)
NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_FAST_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Deep model: used when "Deep reasoning" is ticked in the UI (Nemotron 3 Ultra)
NEBIUS_DEEP_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Embeddings for hybrid retrieval (falls back to BM25-only if unavailable)
NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
NEBIUS_EMBED_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# auto = live if NEBIUS_API_KEY is set, otherwise offline mock. Or force: live | mock
DOCBRIEF_MODE=auto

# --- Optional: live web context for Q&A (Tavily) ---
TAVILY_API_KEY=
